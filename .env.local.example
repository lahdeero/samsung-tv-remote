# Copy to .env.local and adjust for your setup.
# .env.local is gitignored and must never be committed.

TV_IP=192.168.1.95
TV_MAC=B8:B4:09:50:4C:72

# Path to the samsungtv CLI inside the project virtualenv.
SAMSUNGTV_BIN=/home/eero/Projects/tv-remote-controller/.venv/bin/samsungtv

# Path to the persisted Samsung authorization token.
SAMSUNGTV_TOKEN_FILE=/home/eero/Projects/tv-remote-controller/.tv-token

# Wake-on-LAN binary used for the Power On action.
WOL_BIN=wakeonlan
